<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ============================================ -->
    <!-- TEMA PRINCIPAL DE LA APP                     -->
    <!-- ============================================ -->
    <style name="Theme.BitacoraAutomotriz" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/neon_primary</item>
        <item name="colorPrimaryVariant">@color/neon_secondary</item>
        <item name="colorSecondary">@color/neon_accent_1</item>
        <item name="colorSecondaryVariant">@color/neon_accent_2</item>
        <item name="android:colorBackground">@color/neon_background</item>
        <item name="colorSurface">@color/neon_surface</item>
        <item name="colorOnPrimary">@color/neon_text_on_primary</item>
        <item name="colorOnSecondary">@color/neon_text_on_primary</item>
        <item name="colorOnSurface">@color/neon_text_primary</item>
        <item name="colorOnBackground">@color/neon_text_primary</item>
        <item name="colorError">#FF4444</item>
        <item name="colorOnError">#FFFFFF</item>
    </style>

    <!-- ============================================ -->
    <!-- TEMA DE CALENDARIO VERDE UNIFICADO          -->
    <!-- ============================================ -->
    <style name="CalendarioVerdeTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">#006C4C</item>
        <item name="colorPrimary">#006C4C</item>
        <item name="colorPrimaryDark">#004D33</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#006C4C</item>
        <item name="android:textColorPrimaryInverse">#FFFFFF</item>
        <item name="android:headerBackground">#006C4C</item>
    </style>

    <!-- ============================================ -->
    <!-- ESTILOS DE TARJETAS NEÓN                     -->
    <!-- ============================================ -->

    <!-- Tarjeta principal -->
    <style name="Card.Neon" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/neon_surface</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/neon_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Header de tarjeta -->
    <style name="Card.Neon.Header" parent="">
        <item name="android:background">@color/neon_primary</item>
        <item name="android:padding">@dimen/card_header_padding</item>
    </style>

    <!-- Título en header -->
    <style name="Card.Neon.Header.Title" parent="">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Subtítulo en header -->
    <style name="Card.Neon.Header.Subtitle" parent="">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/neon_text_primary</item>
        <item name="android:alpha">0.8</item>
    </style>

    <!-- Body de tarjeta -->
    <style name="Card.Neon.Body" parent="">
        <item name="android:padding">@dimen/card_padding</item>
    </style>

    <style name="Card.Neon.Body.Text" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">#004D40</item>
    </style>

    <!-- Caption (texto pequeño) -->
    <style name="Card.Neon.Body.Caption" parent="">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">#00695C</item>
        <item name="android:alpha">0.8</item>
    </style>

    <!-- ============================================ -->
    <!-- ESTILOS DE BOTONES NEÓN                      -->
    <!-- ============================================ -->

    <!-- Botón principal -->
    <style name="Button.Neon" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/neon_button_primary</item>
        <item name="android:textColor">@color/neon_button_text</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <!-- Botón con borde (outline) -->
    <style name="Button.Neon.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/neon_primary</item>
        <item name="android:textColor">@color/neon_primary</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <!-- Botón de texto (text button) -->
    <style name="Button.Neon.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/neon_primary</item>
        <item name="android:textSize">@dimen/button_text_size</item>
    </style>

    <!-- ============================================ -->
    <!-- ESTILOS DE BADGES NEÓN                       -->
    <!-- ============================================ -->

    <style name="Badge.Neon" parent="">
        <item name="android:background">@color/neon_badge_bg</item>
        <item name="android:textColor">@color/neon_badge_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

    <!-- ============================================ -->
    <!-- ESTILOS DE TEXTOS                            -->
    <!-- ============================================ -->

    <style name="Text.Neon.Title" parent="">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/neon_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Neon.Subtitle" parent="">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/neon_text_secondary</item>
    </style>

    <style name="Text.Neon.Body" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/neon_text_secondary</item>
    </style>

    <style name="Text.Neon.Caption" parent="">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/neon_text_secondary</item>
        <item name="android:alpha">0.7</item>
    </style>

</resources>
