                                cliente = cliente,\n222\t                                    auto = auto,\n223\t                                    fecha = fecha,\n224\t                                    kilometraje = kilometraje,\n225\t                                    fallaReportada = fallaReportada,\n226\t                                    diagnostico = diagnostico,\n227\t                                    trabajoRealizado = trabajoRealizado,\n228\t                                    estado = estado,\n229\t                                    porcentajeAvance = porcentajeAvance,\n230\t                                    fechaEntrega = fechaEntrega,\n231\t                                    costoManoObra = costoManoObra,\n232\t                                    costoRefacciones = costoRefacciones,\n233\t                                    iva = iva,\n234\t                                    total = total\n235\t                                )\n236\t                            )\n237\t                        } catch (e: Exception) {\n238\t                            Log.e(TAG, \"Error procesando hijo en /ordenes: ${e.message}\")\n239\t                        }\n240\t                    }\n241\t                    Log.d(TAG, \"✅ Total órdenes deserializadas correctamente: ${lista.size}\")\n242\t                    onOrdenesActualizadas(lista)\n243\t                }\n244\t\n245\t                override fun onCancelled(error: DatabaseError) {\n246\t                    Log.e(TAG, \"❌ Error escuchando /ordenes en Firebase: ${error.message} (${error.details})\")\n247\t                }\n248\t            })\n249\t        } catch (e: Exception) {\n250\t            Log.e(TAG, \"Error al suscribirse a /ordenes: ${e.message}\")\n251\t        }\n252\t    }\n253\t\n254\t    // ======================================================\n255\t    // 2. SINCRONIZACIÓN DE AUTOS DEL CLIENTE\n256\t    // ======================================================\n257\t\n258\t    fun 