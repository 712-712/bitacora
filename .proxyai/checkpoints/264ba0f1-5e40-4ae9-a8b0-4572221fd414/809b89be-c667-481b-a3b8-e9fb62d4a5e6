                    "text": "1\tpackage com.example.bitacoraautomotriz.ui.ordenes\n2\t\n3\timport android.content.Intent\n4\timport android.net.Uri\n5\timport android.widget.Toast\n6\timport androidx.compose.animation.animateColorAsState\n7\timport androidx.compose.foundation.background\n8\timport androidx.compose.foundation.clickable\n9\timport androidx.compose.foundation.gestures.detectTapGestures\n10\timport androidx.compose.foundation.layout.*\n11\timport androidx.compose.foundation.rememberScrollState\n12\timport androidx.compose.foundation.shape.RoundedCornerShape\n13\timport androidx.compose.foundation.text.KeyboardOptions\n14\timport androidx.compose.foundation.verticalScroll\n15\timport androidx.compose.material3.*\n16\timport androidx.compose.runtime.*\n17\timport androidx.compose.ui.Alignment\n18\timport androidx.compose.ui.Modifier\n19\timport androidx.compose.ui.draw.clip\n20\timport androidx.compose.ui.graphics.Color\n21\timport androidx.compose.ui.graphics.StrokeCap\n22\timport androidx.compose.ui.input.pointer.pointerInput\n23\timport androidx.compose.ui.platform.LocalContext\n24\timport androidx.compose.ui.platform.LocalFocusManager\n25\timport androidx.compose.ui.platform.LocalSoftwareKeyboardController\n26\timport androidx.compose.ui.text.TextStyle\n27\timport androidx.compose.ui.text.font.FontWeight\n28\timport androidx.compose.ui.text.input.ImeAction\n29\timport androidx.compose.ui.text.style.TextAlign\n30\timport androidx.compose.ui.text.style.TextDecoration\n31\timport androidx.compose.ui.unit.dp\n32\timport androidx.compose.ui.unit.sp\n33\timport com.example.bitacoraautomotriz.data.Auto\n34\timport com.example.bitacoraautomotriz.data.Cliente\n35\timport com.example.bitacoraautomotriz.data.OrdenServicio\n36\timport com.example.bitacoraautomotriz.data.RecepcionVehiculo\n37\timport com.example.bitacoraautomotriz.repository.AutoRepository\n38\timport com.example.bitacoraautomotriz.repository.ClienteRepository\n39\timport com.example.bitacoraautomotriz.repository.FirebaseSyncManager\n40\timport com.example.bitacoraautomotriz.repository.OrdenServicioRepository\n41\timport com.example.bitacoraautomotriz.repository.RecepcionRepository\n42\timport com.example.bitacoraautomotriz.ui.componentes.BotonModulo3D\n43\timport com.example.bitacoraautomotriz.ui.theme.Colores\n44\timport kotlinx.coroutines.launch\n45\timport java.util.Locale\n46\t\n47\t@Composable\n48\tfun EnviarInformesClienteScreen(\n49\t    ordenIdInicial: Int = 0,\n50\t    onRegresar: () -> Unit\n51\t) {\n52\t    val context = LocalContext.current\n53\t    val focusManager = LocalFocusManager.current\n54\t    val keyboardController = LocalSoftwareKeyboardController.current\n55\t    val scope = rememberCoroutineScope()\n56\t\n57\t    var ordenes by remember { mutableStateOf<List<OrdenServicio>>(emptyList()) }\n58\t    var ordenSeleccionada by remember { mutableStateOf<OrdenServicio?>(null) }\n59\t    var recepcionDetalle by remember { mutableStateOf<RecepcionVehiculo?>(null) }\n60\t    var todosLosClientes by remember { mutableStateOf<List<Cliente>>(emptyList()) }\n61\t    var clienteSeleccionado by remember { mutableStateOf<Cliente?>(null) }\n62\t    var busquedaCliente by remember { mutableStateOf(\"\") }\n63\t\n64\t    var autosDelCliente by remember { mutableStateOf<List<Auto>>(emptyList()) }\n65\t    var autoSeleccionado by remember { mutableStateOf<Auto?>(null) }\n66\t    var autoDetalle by remember { mutableStateOf<Auto?>(null) }\n67\t    var telefonoCliente by remember { mutableStateOf(\"\") }\n68\t    var clienteId by remember { mutableStateOf(0) }\n69\t\n70\t    var porcentajeAvanceTaller by remember { mutableStateOf(0) }\n71\t    var mostrarTarjetaCotizacionCompleta by remember { mutableStateOf(false) }\n72\t    var mostrarTarjetaRecepcionCompleta by remember { mutableStateOf(false) }\n73\t    var cargando by remember { mutableStateOf(true) }\n74\t\n75\t    LaunchedEffect(Unit) {\n76\t        scope.launch {\n77\t            try {\n78\t                todosLosClientes = ClienteRepository.obtenerClientes(context)\n79\t                ordenes = OrdenServicioRepository.obtenerOrdenes(context)\n80\t                val recepciones = RecepcionRepository.obtenerRecepciones(context)\n81\t                recepcionDetalle = recepciones.lastOrNull()\n82\t\n83\t                if (ordenIdInicial > 0) {\n84\t                    val encontrada = ordenes.find { it.id == ordenIdInicial } ?: ordenes.lastOrNull()\n85\t                    ordenSeleccionada = encontrada\n86\t                    encontrada?.let { o ->\n87\t                        porcentajeAvanceTaller = o.porcentajeAvance\n88\t                        clienteSeleccionado = todosLosClientes.find { c -> c.nombre.equals(o.cliente, ignoreCase = true) }\n89\t                    }\n90\t                } else if (ordenes.isNotEmpty()) {\n91\t                    val ultima = ordenes.last()\n92\t                    ordenSeleccionada = ultima\n93\t                    porcentajeAvanceTaller = ultima.porcentajeAvance\n94\t                    clienteSeleccionado = todosLosClientes.find { c -> c.nombre.equals(ultima.cliente, ignoreCase = true) }\n95\t                }\n96\t            } catch (_: Exception) {\n97\t                todosLosClientes = emptyList()\n98\t            } finally {\n99\t                cargando = false\n100\t            }\n101\t        }\n102\t    }\n103\t\n104\t    LaunchedEffect(clienteSeleccionado) {\n105\t        if (clienteSeleccionado != null) {\n106\t            try {\n107\t                telefonoCliente = clienteSeleccionado!!.telefono\n108\t                clienteId = clienteSeleccionado!!.id\n109\t                val listaAutos = AutoRepository.obtenerAutosPorCliente(clienteSeleccionado!!.nombre, context)\n110\t                autosDelCliente = listaAutos\n111\t                if (listaAutos.size == 1) {\n112\t                    autoSeleccionado = listaAutos.first()\n113\t                    autoDetalle = listaAutos.first()\n114\t                }\n115\t\n116\t                val recepciones = RecepcionRepository.obtenerRecepciones(context)\n117\t                val rEncontrada = recepciones.find { it.cliente.equals(clienteSeleccionado!!.nombre, ignoreCase = true) }\n118\t                if (rEncontrada != null) {\n119\t                    recepcionDetalle = rEncontrada\n120\t                }\n121\t            } catch (_: Exception) {\n122\t                autosDelCliente = emptyList()\n123\t            }\n124\t        } else {\n125\t            autosDelCliente = emptyList()\n126\t        }\n127\t    }\n128\t\n129\t    val queryCliente = busquedaCliente.uppercase().trim()\n130\t    val clientesFiltrados = todosLosClientes.filter { c ->\n131\t        c.nombre.uppercase().contains(queryCliente, ignoreCase = true) ||\n132\t                c.id.toString().contains(queryCliente, ignoreCase = true)\n133\t    }\n134\t\n135\t    val avanceActual = porcentajeAvanceTaller.coerceIn(0, 100)\n136\t\n137\t    val colorCromaticoAvance = when {\n138\t        avanceActual <= 10 -> Color(0xFFD32F2F)\n139\t        avanceActual <= 35 -> Color(0xFFF57C00)\n140\t        avanceActual <= 65 -> Color(0xFFFFB300)\n141\t        avanceActual <= 89 -> Color(0xFF7CB342)\n142\t        else -> Color(0xFF00C853)\n143\t    }\n144\t\n145\t    val colorBarraAnimado by animateColorAsState(targetValue = colorCromaticoAvance, label = \"ColorAvance\")\n146\t\n147\t    val etapaTexto = when {\n148\t        avanceActual == 0 -> \"0% - EN ESPERA / DIAGNÓSTICO INICIAL\"\n149\t        avanceActual <= 25 -> \"25% - INICIO DE REPARACIÓN Y DESARME\"\n150\t        avanceActual <= 50 -> \"50% - MONTAJE DE REFACCIONES Y SERVICIO\"\n151\t        avanceActual <= 75 -> \"75% - FASE FINAL Y PRUEBAS DE MANEJO\"\n152\t        else -> \"100% - REPARACIÓN COMPLETADA\"\n153\t    }\n154\t\n155\t    fun enviarWhatsAppGeneral(textoMensaje: String) {\n156\t        if (clienteSeleccionado == null) {\n157\t            Toast.makeText(context, \"Seleccione un cliente primero\", Toast.LENGTH_SHORT).show()\n158\t            return\n159\t        }\n160\t        val c = clienteSeleccionado!!\n161\t        val telLimpio = c.telefono.replace(Regex(\"[^0-9]\"), \"\")\n162\t\n163\t        if (telLimpio.isBlank()) {\n164\t            Toast.makeText(context, \"El cliente no tiene teléfono registrado\", Toast.LENGTH_SHORT).show()\n165\t            return\n166\t        }\n167\t\n168\t        val intent = Intent(Intent.ACTION_VIEW)\n169\t        intent.data = Uri.parse(\"https://wa.me/52$telLimpio?text=${Uri.encode(textoMensaje)}\")\n170\t        try {\n171\t            context.startActivity(intent)\n172\t        } catch (_: Exception) {\n173\t            Toast.makeText(context, \"No se pudo abrir WhatsApp\", Toast.LENGTH_SHORT).show()\n174\t        }\n175\t    }\n176\t\n177\t    Box(\n178\t        modifier = Modifier\n179\t            .fillMaxSize()\n180\t            .background(Colores.FondoPantalla)\n181\t            .statusBarsPadding()\n182\t            .navigationBarsPadding()\n183\t            .pointerInput(Unit) {\n184\t                detectTapGestures(onTap = {\n185\t                    focusManager.clearFocus()\n186\t                    keyboardController?.hide()\n187\t                })\n188\t            }\n189\t    ) {\n190\t        Column(\n191\t            modifier = Modifier\n192\t                .fillMaxSize()\n193\t                .imePadding()\n194\t                .verticalScroll(rememberScrollState())\n195\t                .padding(start = 24.dp, end = 24.dp, top = 24.dp, bottom = 84.dp),\n196\t            horizontalAlignment = Alignment.CenterHorizontally,\n197\t            verticalArrangement = Arrangement.Top\n198\t        ) {\n199\t            Text(\n200\t                text = \"CENTRO DE NOTIFICACIONES Y AVISOS\",\n201\t                fontSize = 22.sp,\n202\t                fontWeight = FontWeight.Bold,\n203\t                color = Colores.TituloPrincipal,\n204\t                textAlign = TextAlign.Center\n205\t            )\n206\t\n207\t            Spacer(modifier = Modifier.height(4.dp))\n208\t\n209\t            Text(\n210\t                text = \"Envíos directos y barra de avance sincronizados con Firebase\",\n211\t                fontSize = 14.sp,\n212\t                color = Colores.EtiquetaCampo,\n213\t                textAlign = TextAlign.Center\n214\t            )\n215\t\n216\t            Spacer(modifier = Modifier.height(20.dp))\n217\t\n218\t            // CARD 1: RECEPTOR DE LA NOTIFICACIÓN\n219\t            Card(\n220\t                modifier = Modifier.fillMaxWidth(),\n221\t                shape = RoundedCornerShape(14.dp),\n222\t                colors = CardDefaults.cardColors(containerColor = Colores.FondoTarjeta),\n223\t                elevation = CardDefaults.cardElevation(defaultElevation = 6.dp)\n224\t            ) {\n225\t                Column(modifier = Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {\n226\t                    Text(\"1. RECEPTOR DE LA NOTIFICACIÓN\", fontSize = 17.sp, fontWeight = FontWeight.Bold, color = Color.White)\n227\t\n228\t                    if (clienteSeleccionado == null) {\n229\t                        OutlinedTextField(\n230\t                            value = busquedaCliente,\n231\t                            onValueChange = { busquedaCliente = it.uppercase() },\n232\t                            placeholder = { Text(\"Buscar cliente por nombre o ID...\", color = Color.Gray) },\n233\t                            textStyle = TextStyle(color = Color.White, fontSize = 16.sp, fontWeight = FontWeight.Bold),\n234\t                            singleLine = true,\n235\t                            modifier = Modifier.fillMaxWidth()\n236\t                        )\n237\t\n238\t                        if (clientesFiltrados.isNotEmpty()) {\n239\t                            Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {\n240\t                                clientesFiltrados.take(4).forEach { cliente ->\n241\t                                    Button(\n242\t                                        onClick = { clienteSeleccionado = cliente },\n243\t                                        modifier = Modifier.fillMaxWidth(),\n244\t                                        colors = ButtonDefaults.buttonColors(containerColor = Colores.FondoSecundario)\n245\t                                    ) {\n246\t                                        Text(text = \"${cliente.nombre} (${cliente.telefono})\", color = Color.White)\n247\t                                    }\n248\t                                }\n249\t                            }\n250\t                        }\n251\t                    } else {\n252\t                        Column(modifier = Modifier.fillMaxWidth()) {\n253\t                            Text(text = \"CLIENTE: ${clienteSeleccionado!!.nombre.uppercase()}\", fontSize = 16.sp, fontWeight = FontWeight.Bold, color = Color.White)\n254\t                            Text(text = \"TELÉFONO: ${clienteSeleccionado!!.telefono}\", fontSize = 15.sp, fontWeight = FontWeight.Bold, color = Color(0xFF7DFFB2))\n255\t                            Spacer(modifier = Modifier.height(2.dp))\n256\t                            TextButton(\n257\t                                onClick = { clienteSeleccionado = null; autoSeleccionado = null; ordenSeleccionada = null },\n258\t                                contentPadding = PaddingValues(0.dp)\n259\t                            ) {\n260\t                                Text(\"CAMBIAR DE CLIENTE\", color = Color(0xFFFF5252), fontWeight = FontWeight.Bold, fontSize = 14.sp)\n261\t                            }\n262\t                        }\n263\t\n264\t                        if (autoSeleccionado == null) {\n265\t                            if (autosDelCliente.isNotEmpty()) {\n266\t                                Text(\"SELECCIONE EL AUTO DEL CLIENTE:\", fontSize = 15.sp, fontWeight = FontWeight.Bold, color = Colores.EtiquetaCampo)\n267\t                                Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {\n268\t                                    autosDelCliente.forEach { auto ->\n269\t                                        Button(\n270\t                                            onClick = { autoSeleccionado = auto; autoDetalle = auto },\n271\t                                            modifier = Modifier.fillMaxWidth(),\n272\t                                            colors = ButtonDefaults.buttonColors(containerColor = Colores.FondoSecundario)\n273\t                                        ) {\n274\t                                            Text(text = \"🚗 ${auto.marca} ${auto.modelo} (${auto.placa})\", color = Color.White, fontWeight = FontWeight.Bold)\n275\t                                        }\n276\t                                    }\n277\t                                }\n278\t                            }\n279\t                        } else {\n280\t                            Column(modifier = Modifier.fillMaxWidth()) {\n281\t                                Text(text = \"AUTO: ${autoSeleccionado!!.marca.uppercase()} ${autoSeleccionado!!.modelo.uppercase()} (${autoSeleccionado!!.placa.uppercase()})\", fontSize = 16.sp, fontWeight = FontWeight.Bold, color = Color(0xFF7DFFB2))\n282\t                                Spacer(modifier = Modifier.height(2.dp))\n283\t                                TextButton(\n284\t                                    onClick = { autoSeleccionado = null },\n285\t                                    contentPadding = PaddingValues(0.dp)\n286\t                                ) {\n287\t                                    Text(\"CAMBIAR DE AUTO\", color = Color(0xFFFF5252), fontWeight = FontWeight.Bold, fontSize = 14.sp)\n288\t                                }\n289\t                            }\n290\t                        }\n291\t                    }\n292\t                }\n293\t            }\n294\t\n295\t            Spacer(modifier = Modifier.height(20.dp))\n296\t\n297\t            // CARD 2: TARJETA DE ESTADO DE REPARACIÓN Y BARRA CROMÁTICA CON BOTONES 0% A 100%\n298\t            Card(\n299\t                modifier = Modifier.fillMaxWidth(),\n300\t                shape = RoundedCornerShape(14.dp),\n301\t                colors = CardDefaults.cardColors(containerColor = Colores.FondoTarjeta),\n302\t                elevation = CardDefaults.cardElevation(defaultElevation = 6.dp)\n303\t            ) {\n304\t                Column(\n305\t                    modifier = Modifier\n306\t                        .fillMaxWidth()\n307\t                        .padding(18.dp),\n308\t                    horizontalAlignment = Alignment.CenterHorizontally\n309\t                ) {\n310\t                    Text(\n311\t                        text = \"ESTADO DE REPARACIÓN Y AVANCE\",\n312\t                        fontSize = 17.sp,\n313\t                        fontWeight = FontWeight.Bold,\n314\t                        color = Color.White,\n315\t                        textAlign = TextAlign.Center\n316\t                    )\n317\t                    Spacer(modifier = Modifier.height(6.dp))\n318\t\n319\t                    Text(\n320\t                        text = \"$avanceActual%\",\n321\t                        fontSize = 42.sp,\n322\t                        fontWeight = FontWeight.Bold,\n323\t                        color = colorBarraAnimado,\n324\t                        textAlign = TextAlign.Center\n325\t                    )\n326\t\n327\t                    Spacer(modifier = Modifier.height(8.dp))\n328\t\n329\t                    LinearProgressIndicator(\n330\t                        progress = { avanceActual / 100f },\n331\t                        modifier = Modifier\n332\t                            .fillMaxWidth()\n333\t                            .height(22.dp)\n334\t                            .clip(RoundedCornerShape(11.dp)),\n335\t                        color = colorBarraAnimado,\n336\t                        trackColor = Color.Black.copy(alpha = 0.3f),\n337\t                        strokeCap = StrokeCap.Round\n338\t                    )\n339\t\n340\t                    Spacer(modifier = Modifier.height(12.dp))\n341\t\n342\t                    Text(\n343\t                        text = etapaTexto,\n344\t                        fontSize = 15.sp,\n345\t                        fontWeight = FontWeight.Bold,\n346\t                        color = Color.White,\n347\t                        textAlign = TextAlign.Center\n348\t                    )\n349\t\n350\t                    Spacer(modifier = Modifier.height(16.dp))\n351\t\n352\t                    // BOTONES DENTRO DE LA TARJETA DE AVANCE (0%, 25%, 50%, 75%, 100%)\n353\t                    Text(\n354\t                        text = \"ACTUALIZAR AVANCE EN FIREBASE:\",\n355\t                        fontSize = 14.sp,\n356\t                        fontWeight = FontWeight.Bold,\n357\t                        color = Color(0xFF7DFFB2),\n358\t                        modifier = Modifier.align(Alignment.Start)\n359\t                    )\n360\t\n361\t                    Spacer(modifier = Modifier.height(6.dp))\n362\t\n363\t                    Row(\n364\t                        modifier = Modifier.fillMaxWidth(),\n365\t                        horizontalArrangement = Arrangement.spacedBy(6.dp)\n366\t                    ) {\n367\t                        val pasos = listOf(0, 25, 50, 75, 100)\n368\t                        pasos.forEach { paso ->\n369\t                            val esActivo = avanceActual == paso\n370\t                            BotonModulo3D(\n371\t                                texto = \"$paso%\",\n372\t                                colorClaro = if (esActivo) Color(0xFFB9F6CA) else Color(0xFFD5E1E6),\n373\t                                colorMedio = if (esActivo) Color(0xFF00C853) else Color(0xFF90A4AE),\n374\t                                colorOscuro = if (esActivo) Color(0xFF00695C) else Color(0xFF455A64),\n375\t                                onClick = {\n376\t                                    porcentajeAvanceTaller = paso\n377\t                                    val o = ordenSeleccionada\n378\t                                    if (o != null) {\n379\t                                        scope.launch {\n380\t                                            val ordenActualizada = o.copy(porcentajeAvance = paso)\n381\t                                            OrdenServicioRepository.actualizarEstadoYAvance(o.id, o.estado, paso, o.fechaEntrega, context)\n382\t                                            FirebaseSyncManager.subirOrdenAFirebase(ordenActualizada)\n383\t                                            Toast.makeText(context, \"⚡ Avance del $paso% transmitido a la App Cliente\", Toast.LENGTH_SHORT).show()\n384\t                                        }\n385\t                                    } else {\n386\t                                        Toast.makeText(context, \"Avance del $paso% fijado\", Toast.LENGTH_SHORT).show()\n387\t                                    }\n388\t                                },\n389\t                                modifier = Modifier\n390\t                                    .weight(1f)\n391\t                                    .height(46.dp),\n392\t                                tamanioTexto = 13,\n393\t                                colorTexto = if (esActivo) Color.Black else Color.White\n394\t                            )\n395\t                        }\n396\t                    }\n397\t                }\n398\t            }\n399\t\n400\t            Spacer(modifier = Modifier.height(20.dp))\n401\t\n402\t            // CARD 3: CONSOLA DE AVISOS Y NOTIFICACIONES COMPLETA RESTAURADA CON FORMULARIO COMPLETO DE RECEPCIÓN\n403\t            Card(\n404\t                modifier = Modifier.fillMaxWidth(),\n405\t                shape = RoundedCornerShape(14.dp),\n406\t                colors = CardDefaults.cardColors(containerColor = Colores.FondoTarjeta),\n407\t                elevation = CardDefaults.cardElevation(defaultElevation = 6.dp)\n408\t            ) {\n409\t                Column(modifier = Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(14.dp)) {\n410\t                    Text(\"3. CONSOLA DE AVISOS Y NOTIFICACIONES\", fontSize = 17.sp, fontWeight = FontWeight.Bold, color = Color.White)\n411\t\n412\t                    val cNombre = clienteSeleccionado?.nombre?.uppercase() ?: \"ESTIMADO CLIENTE\"\n413\t                    val aNombre = if (autoSeleccionado != null) \"${autoSeleccionado!!.marca} ${autoSeleccionado!!.modelo} (${autoSeleccionado!!.placa})\" else \"su vehículo\"\n414\t\n415\t                    // 1. AVISO Y VISTA COMPLETA DE COTIZACIÓN DE SERVICIO\n416\t                    BotonModulo3D(\n417\t                        texto = \"📄 1. ENVIAR COTIZACIÓN DE SERVICIO AL CLIENTE\",\n418\t                        colorClaro = Color(0xFFD7B899), colorMedio = Color(0xFF9B6B43), colorOscuro = Color(0xFF5D3A1A),\n419\t                        colorTexto = Color.Black,\n420\t                        onClick = {\n421\t                            mostrarTarjetaCotizacionCompleta = !mostrarTarjetaCotizacionCompleta\n422\t                            val o = ordenSeleccionada\n423\t                            if (o != null) {\n424\t                                FirebaseSyncManager.subirOrdenAFirebase(o)\n425\t                                Toast.makeText(context, \"⚡ Cotización enviada a Firebase en tiempo real\", Toast.LENGTH_SHORT).show()\n426\t                            }\n427\t                        },\n428\t                        modifier = Modifier.fillMaxWidth().height(54.dp),\n429\t                        tamanioTexto = 14\n430\t                    )\n431\t\n432\t                    // SI SE SELECCIONA ENVIAR COTIZACIÓN: MUESTRA LA TARJETA VERDE COMPLETA MÁSTER DE COTIZACIÓN\n433\t                    if (mostrarTarjetaCotizacionCompleta || ordenSeleccionada != null) {\n434\t                        val o = ordenSeleccionada ?: OrdenServicio(\n435\t                            id = 3,\n436\t                            cliente = cNombre,\n437\t                            auto = aNombre,\n438\t                            fecha = \"08/10/2026\",\n439\t                            kilometraje = 45000,\n440\t                            fallaReportada = \"FRENOS\",\n441\t                            diagnostico = \"BALATAS\",\n442\t                            trabajoRealizado = \"COMPRA Y COLOCACION BALATAS\",\n443\t                            estado = \"EN ESPERA\",\n444\t                            porcentajeAvance = 0,\n445\t                            fechaEntrega = \"\",\n446\t                            costoManoObra = 50.0,\n447\t                            costoRefacciones = 100.0,\n448\t                            iva = 24.0,\n449\t                            total = 174.0\n450\t                        )\n451\t\n452\t                        Card(\n453\t                            modifier = Modifier.fillMaxWidth(),\n454\t                            shape = RoundedCornerShape(14.dp),\n455\t                            colors = CardDefaults.cardColors(containerColor = Colores.FondoTarjeta),\n456\t                            elevation = CardDefaults.cardElevation(defaultElevation = 6.dp)\n457\t                        ) {\n458\t                            Column(\n459\t                                modifier = Modifier\n460\t                                    .fillMaxWidth()\n461\t                                    .padding(20.dp),\n462\t                                verticalArrangement = Arrangement.spacedBy(8.dp)\n463\t                            ) {\n464\t                                Text(\n465\t                                    text = \"FOLIO: ${String.format(Locale.US, \"%05d\", o.id)}   |   ID: ${if (clienteId > 0) clienteId else 5}\",\n466\t                                    