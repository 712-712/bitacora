xception) {\n132\t            e.printStackTrace()\n133\t        }\n134\t    }\n135\t\n136\t    fun escucharOrdenEnTiempoReal(ordenId: Int, onOrdenActualizada: (OrdenServicio) -> Unit) {\n137\t        try {\n138\t            if (ordenId <= 0) return\n139\t            dbRef?.child(\"ordenes\")?.child(ordenId.toString())\n140\t                ?.addValueEventListener(object : ValueEventListener {\n141\t                    override fun onDataChange(snapshot: DataSnapshot) {\n142\t                        try {\n143\t                            val ordenMap = snapshot.value as? Map<*, *> ?: return\n144\t                            val id = parsearInt(ordenMap[\"id\"]).let { if (it == 0) ordenId else it }\n145\t                            val cliente = ordenMap[\"cliente\"] as? String ?: \"\"\n146\t                            val auto = ordenMap[\"auto\"] as? String ?: \"\"\n147\t                            val fecha = ordenMap[\"fecha\"] as? String ?: \"\"\n148\t                            val kilometraje = parsearInt(ordenMap[\"kilometraje\"])\n149\t                            val fallaReportada = ordenMap[\"fallaReportada\"] as? String ?: \"\"\n150\t                            val diagnostico = ordenMap[\"diagnostico\"] as? String ?: \"\"\n151\t                            val trabajoRealizado = ordenMap[\"trabajoRealizado\"] as? String ?: \"\"\n152\t                            val estado = ordenMap[\"estado\"] as? String ?: \"EN ESPERA\"\n153\t                            val porcentajeAvance = parsearInt(ordenMap[\"porcentajeAvance\"])\n154\t                            val fechaEntrega = ordenMap[\"fechaEntrega\"] as? String ?: \"\"\n155\t                            val costoManoObra = parsearDouble(ordenMap[\"costoManoObra\"])\n156\t                            val costoRefacciones = parsearDouble(ordenMap[\"costoRefacciones\"])\n157\t                            val iva = parsearDouble(ordenMap[\"iva\"])\n158\t                            val total = parsearDouble(ordenMap[\"total\"])\n159\t\n160\t                            val ordenDescargada = OrdenServicio(\n161\t                                id = id,\n162\t                                cliente = cliente,\n163\t                                auto = auto,\n164\t                                fecha = fecha,\n165\t                                kilometraje = kilometraje,\n166\t                                fallaReportada = fallaReportada,\n167\t                                diagnostico = diagnostico,\n168\t                                trabajoRealizado = trabajoRealizado,\n169\t                                estado = estado,\n170\t                                porcentajeAvance = porcentajeAvance,\n171\t                                fechaEntrega = fechaEntrega,\n172\t                                costoManoObra = costoManoObra,\n173\t                                costoRefacciones = costoRefacciones,\n174\t                                iva = iva,\n175\t                                total = total\n176\t                            )\n177\t                            onOrdenActualizada(ordenDescargada)\n178\t                        } catch (e: Exception) {\n179\t                            Log.e(TAG, \"Error al deserializar orden $ordenId: ${e.message}\")\n180\t                        }\n181\t                    }\n182\t\n183\t                    override fun onCancelled(error: DatabaseError) {\n184\t                        Log.e(TAG, \"Error en escucharOrdenEnTiempoReal: ${error.message}\")\n185\t                    }\n186\t                })\n187\t        } catch (e: Exception) {\n188\t            e.printStackTrace()\n189\t        }\n190\t    }\n191\t\n192\t    fun escucharTodasLasOrdenesEnTiempoReal(onOrdenesActualizadas: (List<OrdenServicio>) -> Unit) {\n193\t        try {\n194\t            dbRef?.child(\"ordenes\")?.addValueEventListener(object : ValueEventListener {\n195\t                override fun onDataChange(snapshot: DataSnapshot) {\n196\t           